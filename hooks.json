{
  "PostToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{ cat; echo; } >> \"$HOME/devin-hooks.jsonl\"",
          "powershell": "[Console]::In.ReadToEnd() | Add-Content (Join-Path $HOME 'devin-hooks.jsonl')",
          "timeout": 10000
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{ cat; echo; } >> \"$HOME/devin-hooks.jsonl\"",
          "powershell": "[Console]::In.ReadToEnd() | Add-Content (Join-Path $HOME 'devin-hooks.jsonl')",
          "timeout": 10000
        }
      ]
    }
  ]
}
